@page "/todoItems"
@rendermode InteractiveServer
@using TodoApp.Application.Services
@using TodoApp.Domain.Entities
@inject TodoAppService TodoService

<h3>TodoItems</h3>

<div class="mb-3">
    <input class="form-control" @bind="newTitle" placeholder="Nieuwe taak..." />
    <button class="btn btn-primary mt-2" @onclick="AddTodo">Toevoegen</button>
</div>

<ul class="list-group">
    @foreach (var item in todos)
    {
        <TodoCard Item="item" OnDoneChanged="MarkAsDone" />
    }
</ul>

@code {
    private List<TodoItem> todos = new();
    private string newTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        todos = await TodoService.GetTodosAsync();
    }

    private async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        await TodoService.AddTodoAsync(newTitle);
        newTitle = string.Empty;
        await Load();
    }

    private async Task MarkAsDone(TodoItem item)
    {
        await TodoService.ToggleDoneAsync(item.Id!.Value);
        await Load();
    }

    async Task ToggleTodo(int id)
    {
        await TodoService.ToggleDoneAsync(id);
        await Load();
    }
}
